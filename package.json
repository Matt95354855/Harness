{
  "name": "@matt95354855/agent-harness",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first TypeScript agent harness with bounded execution, tools, memory and reproducible offline tests.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "harness": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/src/cli.js",
    "demo": "tsx src/cli.ts demo",
    "doctor": "tsx src/cli.ts doctor",
    "local:llm": "bash scripts/start-local-llm.sh",
    "local:llm:gpt-oss": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-llm.ps1 -Model gpt-oss",
    "local:llm:qwen": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-llm.ps1 -Model qwen",
    "web:start": "node dist/src/web/server.js",
    "web:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-web-setup.ps1",
    "web:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-web-startup.ps1",
    "web:test": "tsx --test tests/integration/web.test.ts",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:coverage": "c8 --include='src/**/*.ts' --reporter=text --reporter=lcov tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "example:basic": "tsx examples/basic-search.ts",
    "example:advanced": "tsx examples/advanced-agent.ts",
    "example:multi-hop": "tsx examples/multi-hop-reasoning.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "doclaynet:eval": "tsx scripts/doclaynet-adapter.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "c8": "^10.1.3",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
