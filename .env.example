# Copy to .env. The initial demo needs no API key, network or model download.
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_ENDPOINT=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# Configuration locale testée : voir docs/local-model.md pour Qwen3.5 0.8B avec llama.cpp.
# Le script npm run local:llm sert le modèle sous l'identifiant qwen3.5-0.8b-local.
# Set LLM_PROVIDER=openai-compatible and LLM_MODEL to its exact ID.
# LM Studio typically serves http://127.0.0.1:1234/v1.
# Set SEARCH_PROVIDER=none for entirely local operation with a real model.
SEARCH_PROVIDER=fixture
# Live search is opt-in: http or searxng, with an explicit full /search URL.
# SEARCH_ENDPOINT=http://127.0.0.1:8080/search
# SEARCH_API_KEY=

AGENT_NAME=Harness
MAX_ITERATIONS=8
MAX_TOOL_CALLS=12
MAX_TOKENS=1500
MAX_CONTEXT_CHARS=16000
MAX_INPUT_CHARS=8000
MAX_TOOL_RESULT_CHARS=12000
TEMPERATURE=0.2
TOP_P=0.9
RUN_TIMEOUT_MS=120000
TOOL_TIMEOUT_MS=10000
HERMES_REFLECTION=true
REFLECTION_INTERVAL=3
HERMES_MULTI_HOP=true
# If unset, every registered tool is allowed. An empty value disables all tools.
# ALLOWED_TOOLS=calculate,web_search

PERSIST_MEMORY=false
MEMORY_PATH=.harness/memory.json
PERSIST_TRACES=true
TRACE_DIR=.harness/traces
LOG_LEVEL=INFO
LOG_CONSOLE=false
# LOG_FILE=.harness/logs/agent.jsonl
