DATABASE_URL=postgresql://mass:change-me-before-starting@db:5432/mass
REDIS_URL=redis://redis:6379/0
DATA_DIR=/var/lib/mass/data
MODEL_DIR=/var/lib/mass/models
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
