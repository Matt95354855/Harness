# Copy to .env. The initial demo needs no API key, network or model download.
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_ENDPOINT=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# Configuration locale testée : voir docs/local-model.md pour Qwen3.5 0.8B avec llama.cpp.
# Le script npm run local:llm sert le modèle sous l'identifiant qwen3.5-0.8b-local.
# Set LLM_PROVIDER=openai-compatible and LLM_MODEL to its exact ID.
# LM Studio typically serves http://127.0.0.1:1234/v1.
# Set SEARCH_PROVIDER=none for entirely local operation with a real model.
SEARCH_PROVIDER=fixture
# Live search is opt-in: http or searxng, with an explicit full /search URL.
# SEARCH_ENDPOINT=http://127.0.0.1:8080/search
# SEARCH_API_KEY=

# Read public web pages. web_search still requires SEARCH_PROVIDER=http or searxng.
WEB_ACCESS=false

# Comma-separated directories the agent may read. No filesystem access is enabled by default.
# LOCAL_FILE_ROOTS=/Users/you/Documents,/Users/you/Projects

# Optional Google OAuth access token with Drive read-only scope.
# GOOGLE_DRIVE_ACCESS_TOKEN=

# Optional Mass Classification service. The token is never passed as a tool parameter.
# MASS_CLASSIFICATION_URL=http://127.0.0.1:8000
# MASS_CLASSIFICATION_API_KEY=mc_replace_me
# Comma-separated roots from which PDF and DOCX files may be submitted.
# MASS_INPUT_ROOTS=/Users/you/Documents/Classscale
# MASS_MAX_UPLOAD_BYTES=52428800

# Optional MCP configuration. Copy config/mcp.example.json to this ignored path.
MCP_CONFIG_PATH=.harness/mcp.json
# GITHUB_TOKEN=github_pat_replace_me

AGENT_NAME=Harness
MAX_ITERATIONS=8
MAX_TOOL_CALLS=12
MAX_TOKENS=1500
MAX_CONTEXT_CHARS=16000
MAX_INPUT_CHARS=8000
MAX_TOOL_RESULT_CHARS=12000
TEMPERATURE=0.2
TOP_P=0.9
RUN_TIMEOUT_MS=120000
TOOL_TIMEOUT_MS=10000
HERMES_REFLECTION=true
REFLECTION_INTERVAL=3
HERMES_MULTI_HOP=true
# If unset, every registered tool is allowed. An empty value disables all tools.
# ALLOWED_TOOLS=calculate,web_search,web_fetch,local_list,local_read,local_search,drive_search,drive_read,mass_capabilities,mass_submit_document,mass_get_document,mass_search_evidence,mass_submit_feedback

PERSIST_MEMORY=false
MEMORY_PATH=.harness/memory.json
PERSIST_TRACES=true
TRACE_DIR=.harness/traces
LOG_LEVEL=INFO
LOG_CONSOLE=false
# LOG_FILE=.harness/logs/agent.jsonl
